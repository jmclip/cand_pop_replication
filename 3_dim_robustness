var_explained <- function(pc, data, group = "cand_year") {
  a  <- anova(lm(reformulate(group, pc), data = data))
  ss <- a$`Sum Sq`; ms_e <- a$`Mean Sq`[2]
  tibble(
    pc    = pc,
    eta2  = ss[1] / sum(ss),
    omega2 = (ss[1] - a$Df[1] * ms_e) / (sum(ss) + ms_e),
    p     = a$`Pr(>F)`[1] )
}

